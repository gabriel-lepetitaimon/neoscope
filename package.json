{
  "name": "neoscope",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build-all",
    "build-all": "for target in anywidget streamlit; do for file in js/*.tsx; do npx vite build -- --input=\"$(basename \"$file\" .tsx)\" --target=\"$target\" || exit 1; done; done",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf src/neoscope/static/"
  },
  "dependencies": {
    "@anywidget/react": "^0.2.1",
    "@streamlit/component-v2-lib": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@anywidget/vite": "^0.3.0",
    "@html-ng/bounding-client-rect-observer": "^0.1.3",
    "@react-hook/resize-observer": "^2.0.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.7"
  }
}
